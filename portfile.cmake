vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO evanjaramillo/msdf-atlas-gen
    REF 9a745a29e65e7cdd6278c17b6a3dad501a17e4f1
    SHA512 5861b97d5ee054091586e11472d76843b649beb513f33e703b887b39979de11f78f12c006d36dc929360449e3b32bc1033190f9e1fec7162d9dc6e458e6a4655
    HEAD_REF master
)
vcpkg_cmake_configure(
        SOURCE_PATH ${SOURCE_PATH}
        OPTIONS
        -DMSDF_ATLAS_BUILD_STANDALONE=OFF
        -DMSDF_ATLAS_NO_ARTERY_FONT=ON
        -DMSDF_ATLAS_MSDFGEN_EXTERNAL=ON
        -DMSDF_ATLAS_INSTALL=ON
)
vcpkg_cmake_install()
vcpkg_cmake_config_fixup(CONFIG_PATH lib/cmake)

file(
  INSTALL "${SOURCE_PATH}/LICENSE.txt"
  DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}"
  RENAME copyright
)

file(
    COPY "${CURRENT_PACKAGES_DIR}/share/${PORT}/${PORT}"
    DESTINATION "${CURRENT_PACKAGES_DIR}/share"
)
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/share/${PORT}/${PORT}")
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/include")
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/share")
